# ---- API ----
API_PORT=3001
NODE_ENV=development

# ---- Auth (OIDC / JWT) ----
JWT_SECRET=dev-only-change-me
JWT_ISSUER=https://auth.agentflow.local
JWT_AUDIENCE=agentflow-api
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# ---- Postgres ----
DATABASE_URL=postgresql://agentflow:agentflow@localhost:5432/agentflow?schema=public

# ---- RLS: 2ª barrera de aislamiento por tenant (M10, opt-in) ----
# Con RLS_ENABLED=1 la API conecta con el rol RESTRINGIDO agentflow_app (sin BYPASSRLS) y fija el
# tenant por petición, de modo que las políticas de prisma/rls.sql filtran a nivel de BD aunque el
# chequeo de aplicación fallara. Aplica antes: `pnpm --filter @core/infra rls:apply`.
# Migraciones/seed/worker siguen con DATABASE_URL (rol owner, modo sistema).
RLS_ENABLED=0
DATABASE_URL_RLS=postgresql://agentflow_app:agentflow_app_dev_pw@localhost:5432/agentflow?schema=public

# ---- Redis / BullMQ ----
REDIS_URL=redis://localhost:6379

# Despacho de ejecuciones y triggers programados. NO hace falta tocarlo: el modo durable
# (PERSISTENCE=postgres) implica `queue` automáticamente (usa BullMQ + worker), de modo que los
# webhooks Y los triggers programados (cron/intervalo) funcionan desde la UI sin flags. El modo
# memoria (lite) usa `inline`. Fija DISPATCH solo para forzar un modo explícito (`queue` | `inline`).
# DISPATCH=queue

# ---- Conectores OAuth (M11) ----
# El proveedor `dev` funciona sin configurar (OAuth simulado por la propia API). Para conectar
# proveedores REALES, registra una app OAuth en cada uno con la redirect URI:
#   <API_SELF_URL>/connectors/callback   (p. ej. http://localhost:3001/connectors/callback)
# y fija sus credenciales aquí. API_SELF_URL debe ser la URL pública de la API (para la redirect URI).
# API_SELF_URL=http://localhost:3001
# Slack  → https://api.slack.com/apps  (scopes: chat:write, channels:read)
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# Jira/Atlassian → https://developer.atlassian.com/console/myapps (OAuth 2.0 3LO; scopes: read/write:jira-work, offline_access)
# JIRA_CLIENT_ID=
# JIRA_CLIENT_SECRET=
# GitHub → https://github.com/settings/developers  (scopes: repo)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# ---- Secret Manager (envelope encryption, AES-256-GCM) ----
# Formato: hex de 64 chars, base64 de 32 bytes, o passphrase (derivada con SHA-256).
# OBLIGATORIO en producción: con NODE_ENV=production y sin esta clave, el arranque FALLA
# (no cae en una clave de desarrollo pública). En dev, si falta, se usa una clave derivada con aviso.
KMS_MASTER_KEY=dev-only-32-byte-key-change-me!!

# ---- IA / LLM: cadena de fallback entre proveedores (M33) ----
# Orden: Groq (por defecto) → si se agota (429/cuota) → OpenAI → si se agota → Anthropic.
# Cada eslabón solo se activa si su clave está presente. Los modelos por defecto son sobrescribibles.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# ---- Cuota de IA por workspace (M33) ----
# Tope DIARIO de tokens LLM por workspace (se resetea cada día). 0 = ilimitado.
# Evita que un usuario agote el presupuesto común. Se aplica a «Construir/editar con IA» y a las tools MCP.
WORKSPACE_TOKEN_LIMIT=0

# ---- Web ----
VITE_API_URL=http://localhost:3001
