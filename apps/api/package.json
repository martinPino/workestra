{
  "name": "@app/api",
  "private": true,
  "version": "0.0.0",
  "description": "Workestra API (Cloudflare Workers): REST + WebSocket sobre Durable Objects, auth JWT, RBAC, tenant.",
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir dist",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --exclude \"**/*.workers.test.ts\" --exclude \"**/node_modules/**\"",
    "test:workers": "WRANGLER_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=postgresql://u:p@localhost:5432/db vitest run --config vitest.workers.config.mts"
  },
  "dependencies": {
    "@core/contracts": "workspace:*",
    "@core/domain": "workspace:*",
    "@core/engine": "workspace:*",
    "@core/infra": "workspace:*",
    "@core/llm": "workspace:*",
    "@core/sdk-plugins": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "hono": "^4.13.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.21.3",
    "@types/node": "^22.10.2",
    "vite": "^6",
    "vitest": "^4",
    "wrangler": "^4.122.0"
  }
}
