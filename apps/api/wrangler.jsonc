{
  // API sobre Cloudflare Workers. Fase 3 de docs/CLOUDFLARE.md.
  //
  // Portado todo el API salvo /mcp y /analytics, que responden 501 (ver worker.ts).
  "$schema": "https://developers.cloudflare.com/schemas/wrangler.json",
  "name": "workestra-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-01",

  // `nodejs_compat` da node:crypto (scrypt, AES-GCM), node:async_hooks (el contexto de tenant que usa
  // la barrera RLS) y puebla process.env desde vars y secrets — que es lo que permite que
  // createLlmRouter() y compañía sigan leyendo su configuración sin cambios.
  "compatibility_flags": ["nodejs_compat"],

  "observability": { "enabled": true },

  // Las librerías de OCR/PDF/navegador se cargan con un `require()` perezoso, pero el bundler las
  // resuelve igual y entran en el Worker: 1,01 → 3,04 MB gzip de código que ahí no puede correr. Se
  // sustituyen por un stub que falla con un mensaje claro cuando alguien ejecuta uno de esos nodos.
  // Se retira en la fase 5, cuando pasen a Containers/Sandboxes.
  "alias": {
    "tesseract.js": "./src/stubs/node-only.ts",
    "pdf-parse": "./src/stubs/node-only.ts",
    "playwright": "./src/stubs/node-only.ts",
    "playwright-core": "./src/stubs/node-only.ts"
  },

  // Pool de Postgres del lado de Cloudflare, apuntando al proyecto de Supabase. Hyperdrive NO es una
  // base de datos: agrupa conexiones a una que ya existe. El Postgres que daba Railway está retirado.
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "88e3973177144db798d1509831407d72" }],

  // Ficheros efímeros de ejecución (M48). OJO: la caducidad de 48 h es una lifecycle rule del bucket,
  // no código — sin ella el bucket crece para siempre:
  //   wrangler r2 bucket lifecycle add workestra-files --prefix file/ --expire-days 2
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "workestra-files" }],

  "durable_objects": {
    "bindings": [
      { "name": "EXECUTION_ROOM", "class_name": "ExecutionRoom" },
      { "name": "WORKSPACE_USAGE", "class_name": "WorkspaceUsage" }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ExecutionRoom", "WorkspaceUsage"]
    }
  ],

  // Ejecución durable: una instancia por ejecución, con el executionId como id (dedupe). Sustituye a
  // la cola `execution` de BullMQ y al proceso apps/worker.
  "workflows": [{ "binding": "EXECUTION", "name": "execution", "class_name": "ExecutionWorkflow" }],

  // Disparo de los triggers programados. Cada minuto porque los patrones cron son POR SCHEDULE y viven
  // en la base de datos; Cloudflare solo admite crons fijos aquí, así que el tick es minutal y `dueNow`
  // decide a quién le toca. Sustituye a los repeatable jobs de BullMQ.
  "triggers": { "crons": ["* * * * *"] },

  // Fase 5: los tres nodos que no caben en un isolate (code, browser, extract). Se declara comentado
  // porque exige construir y publicar la imagen primero (`containers/runtime/Dockerfile`) y el plan
  // Workers Paid; descomentar cuando la imagen exista o el despliegue falla al resolverla.
  //
  // "containers": [
  //   { "class_name": "RuntimeContainer", "image": "./containers/runtime/Dockerfile", "instance_type": "standard-1" }
  // ],

  "vars": {}

  // Secretos (`wrangler secret put`, NUNCA aquí): JWT_SECRET, KMS_MASTER_KEY, BREVO_API_KEY o
  // RESEND_API_KEY, y los *_CLIENT_SECRET de Slack/Jira/GitHub.
  //
  // KMS_MASTER_KEY debe ser EXACTAMENTE el mismo valor que en Railway: cifra los tokens de conectores
  // con AES-GCM, y con otro valor quedan indescifrables y todo el mundo tiene que reconectar sus
  // integraciones. Es el único dato de la migración que no se puede regenerar.
}
