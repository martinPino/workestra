{
  "name": "@app/worker",
  "private": true,
  "version": "0.0.0",
  "description": "Worker BullMQ stateless que ejecuta @core/engine. Escala horizontalmente.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "demo": "tsx src/demo.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@core/contracts": "workspace:*",
    "@core/engine": "workspace:*",
    "@core/infra": "workspace:*",
    "@core/llm": "workspace:*",
    "@core/sdk-plugins": "workspace:*",
    "bullmq": "^5.34.5",
    "ioredis": "^5.4.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2"
  }
}
