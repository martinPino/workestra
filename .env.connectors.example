# Credenciales de conectores OAuth para desarrollo local.
# Copia a `.env.connectors` (gitignored) y rellena con las de TUS apps registradas.
# Lo usa `scripts/connectors-dev.sh`. El proveedor `dev` NO necesita nada de esto.
#
# Redirect URL a registrar en cada app: la que imprime el script (https://<túnel>/connectors/callback).

# ---- Slack (https://api.slack.com/apps → OAuth & Permissions; activa Public Distribution) ----
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# ---- Jira / Atlassian (https://developer.atlassian.com/console/myapps → OAuth 2.0 3LO) ----
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=

# ---- GitHub (https://github.com/settings/developers) ----
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Opcionales (el script pone defaults de dev sensatos):
# KMS_MASTER_KEY=
# JWT_SECRET=
# DATABASE_URL=postgresql://agentflow:agentflow@localhost:5432/agentflow?schema=public
# WEB_URL=http://localhost:5173
