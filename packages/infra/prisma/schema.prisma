// Modelo de datos AgentFlow — multitenant por organizationId/workspaceId.
// Los Workflows son inmutables vía WorkflowVersion (snapshot). ExecutionLog es append-only (replay).
// RLS: ver prisma/rls.sql (segunda barrera de aislamiento entre tenants, además del middleware por workspaceId).

generator client {
  provider = "prisma-client-js"
  // `driverAdapters` permite inyectar el driver de conexión en vez de usar el motor nativo de Prisma.
  // Es lo que hace posible correr en Cloudflare Workers: allí no hay binario del query engine, así que
  // la conexión la abre `pg` a través del pool de Hyperdrive (ver src/cloudflare/prisma.ts). En Node el
  // comportamiento no cambia: `createPrismaClient()` sigue usando el motor nativo.
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------- Tenancy / IAM -----------------------------

model Organization {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  plan        String       @default("free")
  createdAt   DateTime     @default(now())
  workspaces  Workspace[]
  memberships Membership[]
  invitations Invitation[]
}

model Workspace {
  id             String       @id @default(cuid())
  organizationId String
  org            Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  slug           String
  createdAt      DateTime     @default(now())

  workflows  Workflow[]
  agents     Agent[]
  tools      Tool[]
  connectors Connector[]
  secrets    Secret[]
  prompts    Prompt[]
  memories   Memory[]
  webhooks   Webhook[]
  plugins    Plugin[]
  apiKeys    ApiKey[]

  @@unique([organizationId, slug])
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String
  name         String
  createdAt    DateTime     @default(now())
  memberships  Membership[]
}

enum Role {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

model Membership {
  id             String       @id @default(cuid())
  userId         String
  organizationId String
  workspaceId    String?
  role           Role         @default(VIEWER)
  // Cuenta «cerrada» (M74): al desactivar a un miembro se marca aquí; bloquea su login y se puede revertir.
  disabledAt     DateTime?
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org            Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId, workspaceId])
  @@index([organizationId])
}

// Invitación a un equipo (M74): un OWNER/ADMIN invita por email con un rol. El token en claro viaja en el
// enlace; en BD solo su hash. Al aceptar se crea/añade la Membership en la org+workspace y se marca acceptedAt.
model Invitation {
  id              String       @id @default(cuid())
  organizationId  String
  org             Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspaceId     String
  email           String // destinatario, en minúsculas
  role            Role // rol con el que se unirá (OWNER nunca es invitable)
  tokenHash       String       @unique // sha256(tokenEnClaro) hex; el token en claro nunca se guarda
  invitedByUserId String
  createdAt       DateTime     @default(now())
  expiresAt       DateTime
  acceptedAt      DateTime?

  @@index([organizationId])
  @@index([email])
}

// ----------------------------- Workflows -----------------------------

model Workflow {
  id               String            @id @default(cuid())
  workspaceId      String
  workspace        Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name             String
  status           WorkflowStatus    @default(DRAFT)
  currentVersionId String?
  createdAt        DateTime          @default(now())
  versions         WorkflowVersion[]
  executions       Execution[]
  webhooks         Webhook[]
  schedules        ScheduledTrigger[]
  triggerBindings  TriggerBinding[]

  @@index([workspaceId])
}

enum WorkflowStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model WorkflowVersion {
  id            String      @id @default(cuid())
  workflowId    String
  workflow      Workflow    @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  version       Int
  state         String      @default("draft") // draft | published | archived
  graphSnapshot Json
  createdBy     String
  publishedAt   DateTime?
  createdAt     DateTime    @default(now())
  nodes         Node[]
  edges         Edge[]
  executions    Execution[]

  @@unique([workflowId, version])
}

model Node {
  id                String          @id @default(cuid())
  workflowVersionId String
  version           WorkflowVersion @relation(fields: [workflowVersionId], references: [id], onDelete: Cascade)
  type              String
  key               String
  config            Json
  position          Json
  agentId           String?
  toolId            String?

  @@unique([workflowVersionId, key])
}

model Edge {
  id                String          @id @default(cuid())
  workflowVersionId String
  version           WorkflowVersion @relation(fields: [workflowVersionId], references: [id], onDelete: Cascade)
  sourceNodeKey     String
  targetNodeKey     String
  sourceHandle      String?
  condition         Json?
}

// ----------------------------- Executions -----------------------------

model Execution {
  id                String          @id @default(cuid())
  workflowId        String?
  workflow          Workflow?       @relation(fields: [workflowId], references: [id])
  workflowVersionId String
  // onDelete: Cascade — borrar un workflow (→ sus versiones) arrastra sus ejecuciones e historial en UNA
  // operación atómica. Antes era Restrict: exigía borrar las ejecuciones aparte (no atómico, con carrera).
  version           WorkflowVersion @relation(fields: [workflowVersionId], references: [id], onDelete: Cascade)
  workspaceId       String
  parentExecutionId String?
  parent            Execution?      @relation("ExecutionTree", fields: [parentExecutionId], references: [id])
  children          Execution[]     @relation("ExecutionTree")
  status            ExecutionStatus @default(QUEUED)
  triggerType       String
  context           Json
  tokensUsed        Int             @default(0)
  costEstimate      Decimal         @default(0)
  startedAt         DateTime?
  finishedAt        DateTime?
  createdAt         DateTime        @default(now())
  logs              ExecutionLog[]
  nodeRuns          NodeRun[]
  pendingReviews    PendingReview[]
  events            ExecutionEventRecord[]

  @@index([workspaceId, status])
  @@index([parentExecutionId])
}

// Trigger PROGRAMADO (M7-B): dispara ejecuciones de un workflow por cron o por intervalo. La
// planificación real vive en BullMQ (repeatable jobs, jobId = id); esta fila es el registro durable
// (para listar/borrar por tenant y re-registrar los repeatables al arrancar).
model ScheduledTrigger {
  id          String    @id @default(cuid())
  workspaceId String
  workflowId  String
  workflow    Workflow  @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  cron        String? // patrón cron de 5 campos (excluyente con everyMs)
  everyMs     Int? // intervalo en ms (excluyente con cron)
  poll        Json? // M52: config de sondeo (p. ej. {provider,connectorId,folderId}) → lista y dispara por fichero nuevo
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())

  @@index([workspaceId])
  @@index([workflowId])
}

// Stream de eventos APPEND-ONLY (M6: observabilidad/replay). Fuente de verdad del replay
// determinista: el payload guarda el ExecutionEvent completo (versionado); la unique
// (executionId, seq) hace el append idempotente ante retries y el doble camino worker→hub.
model ExecutionEventRecord {
  id          String    @id @default(cuid())
  executionId String
  execution   Execution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  seq         Int
  type        String
  at          DateTime
  payload     Json

  @@unique([executionId, seq])
  @@index([executionId, seq])
}

// Revisión humana (human-in-the-loop, M5). Una por (ejecución, nodo): el nodo Humano la crea
// `pending` y suspende la ejecución; la resolución (aprobar/rechazar) es idempotente y DURABLE, de
// modo que el worker que reanuda en otro proceso lee el veredicto persistido.
model PendingReview {
  id          String    @id @default(cuid())
  executionId String
  execution   Execution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  nodeKey     String
  status      String    @default("pending") // pending | approved | rejected
  reason      String
  decision    String?
  resolvedBy  String?
  createdAt   DateTime  @default(now())
  expiresAt   DateTime?

  @@unique([executionId, nodeKey])
  @@index([executionId])
}

// Estado runtime por nodo de una ejecución (proyección derivada del stream de eventos).
model NodeRun {
  id          String    @id @default(cuid())
  executionId String
  execution   Execution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  nodeKey     String
  status      String
  attempt     Int       @default(1)
  startedAt   DateTime?
  finishedAt  DateTime?

  @@unique([executionId, nodeKey])
  @@index([executionId])
}

enum ExecutionStatus {
  QUEUED
  RUNNING
  PAUSED
  WAITING_HUMAN
  SUCCEEDED
  FAILED
  CANCELLED
}

model ExecutionLog {
  id            String    @id @default(cuid())
  executionId   String
  execution     Execution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  nodeKey       String
  stepKey       String
  level         String
  status        String
  input         Json?
  output        Json?
  prompt        Json?
  modelResponse Json?
  tokens        Int       @default(0)
  cost          Decimal   @default(0)
  durationMs    Int       @default(0)
  createdAt     DateTime  @default(now())

  @@unique([executionId, stepKey])
  @@index([executionId, createdAt])
}

// ----------------------------- Agents / Plugins / Integrations -----------------------------

model Agent {
  id             String    @id @default(cuid())
  workspaceId    String
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  systemPrompt   String
  model          String
  tools          String[]
  mcpServers     Json?
  memoryScope    String?
  variables      Json?
  limits         Json?
  permissions    Json?
  isOrchestrator Boolean   @default(false)

  @@index([workspaceId])
}

model Tool {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  key         String
  pluginId    String?
  schema      Json
  authConfig  Json?

  @@unique([workspaceId, key])
}

model Connector {
  id                  String    @id @default(cuid())
  workspaceId         String
  workspace           Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  key                 String
  pluginId            String?
  provider            String
  status              String    @default("disconnected") // disconnected | connected
  credentialsSecretId String?

  @@unique([workspaceId, key])
}

model Secret {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  key         String
  ciphertext  String
  kmsKeyId    String
  version     Int       @default(1)

  @@unique([workspaceId, key])
}

model Webhook {
  id              String    @id @default(cuid())
  workspaceId     String
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workflowId      String
  workflow        Workflow  @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  event           String
  url             String
  signingSecretId String
  active          Boolean   @default(true)

  @@index([workspaceId])
}

// Enlace disparador ↔ workflow para triggers SIN CÓDIGO (M19): el usuario elige «Cuando se crea un
// ticket de Jira» y AgentFlow registra el webhook EN Jira por él. Guarda el webhook interno de ingreso
// (`webhookId`) y el id del webhook creado en el proveedor (`remoteId`, CSV) para poder borrarlo/renovarlo.
model TriggerBinding {
  id          String   @id @default(cuid())
  workspaceId String
  workflowId  String
  workflow    Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  eventId     String // receta del catálogo, p. ej. 'jira.issue_created'
  connectorId String // conector OAuth usado para registrar el webhook en el proveedor
  webhookId   String // webhook interno (/hooks/<webhookId>) que arranca la ejecución
  remoteId    String? // id(s) del webhook creado EN el proveedor (CSV), para borrar/renovar
  params      Json // { projectKey, cloudId, … }
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([workspaceId])
  @@index([workflowId])
}

model Memory {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  scope       String
  ownerId     String
  key         String
  value       Json
  kind        String
  /// Caducidad (M81): la memoria «solo esta ejecución» se marca al escribirla y no se lee pasada la fecha.
  expiresAt   DateTime?

  @@unique([workspaceId, scope, ownerId, key])
  @@index([workspaceId, scope, ownerId])
  @@index([expiresAt])
}

model Prompt {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  template    String
  variables   Json?
  version     Int       @default(1)
}

// Clave de API por workspace (M32): credencial DURADERA para que apps externas (Claude Desktop, ChatGPT,
// Cursor) hablen con la API / el servidor MCP. Se guarda solo el sha256 de la clave (`hashedKey`); la clave
// en claro (`af_…`) se muestra UNA vez al crearla. `role` es un snapshot del rol al emitirla (dirige el RBAC).
model ApiKey {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userSub     String // `sub` del principal (para req.user)
  email       String // snapshot para whoami/listado
  role        Role // snapshot del rol al crear la clave
  hashedKey   String    @unique // sha256(raw) hex; la clave en claro NUNCA se guarda
  prefix      String // "af"
  last4       String // últimos 4 chars, para mostrar en la lista
  label       String
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime?
  revokedAt   DateTime?

  @@index([workspaceId])
  @@index([hashedKey])
}

model Plugin {
  id          String     @id @default(cuid())
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  key         String
  kind        String
  version     String
  manifest    Json
  status      String
  source      String

  @@unique([workspaceId, key, version])
}

// ===================================================================================================
// Product analytics (M84). Cómo se usa el producto, no cuánta gente pasa.
//
// Ninguna de estas tablas tiene relación (FK) con Workspace/User a propósito: es telemetría append-only
// con su propia retención, y una FK en la tabla caliente cobra una comprobación por cada inserción y
// convierte «borrar un workspace» en borrar millones de filas dentro de una transacción. El borrado se
// hace explícito (ver el endpoint de olvido) en vez de por cascada.
// ===================================================================================================

/// Eventos en crudo. Se escribe mucho y se lee poco: el dashboard vive de los rollups, y esto solo se
/// consulta para embudos dentro de la ventana y para rehacer un rollup tras un fallo.
model AnalyticsEvent {
  /// Hora del cliente, ya acotada por el servidor a ±24 h de la recepción (un reloj torcido falsea el DAU).
  at          DateTime @db.Timestamptz
  /// Generado por el cliente al ENCOLAR. Con `at` forma la clave: reintentar el mismo evento no duplica.
  id          String   @db.Uuid
  receivedAt  DateTime @default(now()) @db.Timestamptz
  workspaceId String
  userId      String
  sessionId   String   @db.Uuid
  /// Orden dentro de la sesión: lo que permite montar embudos después sin rehacer nada.
  seq         Int
  name        String
  surface     String
  tab         String   @default("")
  entityType  String   @default("")
  entityId    String   @default("")
  durationMs  Int?
  props       Json     @default("{}")

  /// Clave compuesta por tiempo: si algún día hace falta particionar por mes, la parte cara (cambiar la
  /// PK) ya está hecha. Hoy NO se particiona: Prisma 5 no emite `PARTITION BY`, así que habría que editar
  /// la migración a mano y `prisma migrate dev` reportaría drift para siempre, en cada cambio futuro.
  @@id([at, id])
  @@index([workspaceId, at(sort: Desc)])
  @@index([workspaceId, name, at(sort: Desc)])
  /// Vista de plataforma (todos los tenants) y barrido de retención.
  @@index([at])
}

/// Rollup por hora de pantallas y pestañas. Aditivo: el día es la suma de sus 24 horas selladas.
model AnalyticsHourlyView {
  workspaceId  String
  hour         DateTime @db.Timestamptz
  surface      String
  tab          String   @default("")
  views        Int      @default(0)
  sessions     Int      @default(0)
  dwellMs      BigInt   @default(0)
  /// Denominador PROPIO: la media es dwellMs/dwellSamples. Dividir por `views` mete ceros en el
  /// denominador y hunde la media sin que nadie lo note.
  dwellSamples Int      @default(0)

  @@id([workspaceId, hour, surface, tab])
  @@index([hour])
}

/// Rollup por hora de eventos, con su ENTIDAD. Sin esta dimensión, «qué automatización se edita más»,
/// «qué conector se usa más» y «qué plantilla se instala más» acaban escaneando eventos crudos.
model AnalyticsHourlyEvent {
  workspaceId String
  hour        DateTime @db.Timestamptz
  name        String
  entityType  String   @default("")
  entityId    String   @default("")
  count       Int      @default(0)
  users       Int      @default(0)

  @@id([workspaceId, hour, name, entityType, entityId])
  @@index([hour])
}

/// Conjunto persona×día. Los únicos no se pueden sumar entre horas, así que DAU/WAU/MAU y la retención
/// salen de aquí y no de sumar rollups. Se conserva SIEMPRE (personas × días ocupa nada).
model AnalyticsUserDay {
  workspaceId String
  day         DateTime @db.Date
  userId      String
  /// Escrito al ingerir, no deducido después: si se dedujera escaneando el histórico, la purga de los
  /// 90 días convertiría a un usuario de hace un año en «nuevo» y la retención saldría mal —y hacia
  /// arriba, que es la peor dirección para equivocarse—.
  firstSeenDay DateTime @db.Date
  sessions    Int      @default(0)
  activeMs    BigInt   @default(0)

  @@id([workspaceId, day, userId])
  @@index([day])
  @@index([workspaceId, firstSeenDay])
}

/// Una fila por sesión. La cierra el rollup a partir de min/max de los eventos: las sesiones que más
/// importan (cierre de golpe, caída, móvil en segundo plano) nunca mandan un «he terminado».
model AnalyticsSession {
  id           String   @id @db.Uuid
  workspaceId  String
  userId       String
  startedAt    DateTime @db.Timestamptz
  lastSeenAt   DateTime @db.Timestamptz
  activeMs     BigInt   @default(0)
  eventCount   Int      @default(0)
  device       String?
  browser      String?
  os           String?
  timezone     String?
  /// Requiere una CDN delante que inyecte el país; sin ella queda NULL, y así se dice en el dashboard.
  country      String?
  entrySurface String?
  exitSurface  String?

  @@index([workspaceId, startedAt(sort: Desc)])
  @@index([startedAt])
}

/// INVENTARIO de funciones. Responde «¿qué no usa casi nadie?»: una función que no se dispara nunca no
/// deja filas, así que sin algo enfrente contra lo que cruzar es invisible.
model AnalyticsFeature {
  kind  String
  key   String
  label String
  /// Desde cuándo está medida. Distingue «no la usa nadie» de «no la hemos instrumentado todavía».
  instrumentedSince DateTime @db.Date
  retiredAt         DateTime? @db.Date

  @@id([kind, key])
}

/// Marca de agua del rollup: hasta qué hora está sellado, y las métricas que disparan la mudanza de
/// motor (filas, bytes, eventos/24 h). Un umbral que nadie mide es un comentario.
model AnalyticsRollupWatermark {
  bucket        String   @id
  sealedThrough DateTime @db.Timestamptz
  lastRunAt     DateTime @db.Timestamptz
  metrics       Json     @default("{}")
}

/// Búsquedas en claro SOLO cuando las han tecleado 5+ personas distintas del mismo workspace. Lo que
/// escribe mucha gente es una señal de producto; lo que escribió una sola persona es de esa persona.
model AnalyticsSearchTerm {
  workspaceId String
  day         DateTime @db.Date
  queryHash   String
  scope       String
  text        String
  users       Int      @default(0)
  searches    Int      @default(0)

  @@id([workspaceId, day, queryHash])
  @@index([workspaceId, day])
}

/// Compartir un workflow por enlace (M85). El token en claro viaja en /import/<token>; en BD solo su hash.
/// `snapshot` es la copia SANITIZADA e INMUTABLE del workflow (como WorkflowVersion.graphSnapshot): editar
/// o borrar el workflow origen después NO altera ni filtra lo ya compartido. `workflowId` es columna suelta
/// SIN relación, a propósito: así un `onDelete: Cascade` del Workflow nunca toca el share.
model WorkflowShare {
  id              String    @id @default(cuid())
  workspaceId     String
  workflowId      String? // origen, solo informativo (sin relación)
  sourceName      String // nombre denormalizado para mostrar sin cargar el workflow
  tokenHash       String    @unique // sha256(tokenEnClaro) hex
  snapshot        Json // PortableWorkflowDoc sanitizado
  report          Json // ShareReport congelado (qué se quitó/redactó)
  redactionCount  Int       @default(0)
  createdByUserId String
  createdAt       DateTime  @default(now())
  expiresAt       DateTime? // null = sin caducidad
  revokedAt       DateTime? // revocación blanda: conserva importCount
  importCount        Int       @default(0)
  lastImportedAt     DateTime?
  importerWorkspaceIds String[] @default([]) // workspaces distintos que importaron; importCount = su tamaño

  @@index([workspaceId])
}
